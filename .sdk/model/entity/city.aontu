# Entity: city

main: kit: entity: city: {

  alias: field: {}

  fields: {
    area: {
      h: "Area"
      n: "area"
      r: false
      sh: "Area in km²"
      t: "`$NUMBER`"
    }
    countryCode: {
      h: "Country Code"
      n: "countryCode"
      r: true
      sh: "ISO country code"
      t: "`$STRING`"
    }
    countryEmoji: {
      h: "Country Emoji"
      n: "countryEmoji"
      r: true
      sh: "Emoji flag of the country"
      t: "`$STRING`"
    }
    countryId: {
      h: "Country Id"
      n: "countryId"
      r: true
      sh: "UUID of the country"
      t: "`$STRING`"
    }
    countryName: {
      h: "Country Name"
      n: "countryName"
      r: true
      sh: "Country name"
      t: "`$STRING`"
    }
    countryTelephoneCode: {
      h: "Country Telephone Code"
      n: "countryTelephoneCode"
      r: false
      sh: "Telephone code of the country"
      t: "`$STRING`"
    }
    dialingCode: {
      h: "Dialing Code"
      n: "dialingCode"
      r: false
      sh: "Dialing code"
      t: "`$STRING`"
    }
    distanceKm: {
      h: "Distance Km"
      n: "distanceKm"
      r: false
      sh: "Distance from the given point in kilometers"
      t: "`$NUMBER`"
    }
    elevation: {
      h: "Elevation"
      n: "elevation"
      r: false
      sh: "Elevation in meters"
      t: "`$NUMBER`"
    }
    flagImage: {
      h: "Flag Image"
      n: "flagImage"
      r: false
      sh: "Flag image URL"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Geomelon UUID of the city"
      t: "`$STRING`"
    }
    latitude: {
      h: "Latitude"
      n: "latitude"
      r: false
      sh: "Latitude coordinate"
      t: "`$NUMBER`"
    }
    localizedName: {
      h: "Localized Name"
      n: "localizedName"
      r: true
      sh: "Localized name according to preferred languages"
      t: "`$STRING`"
    }
    longitude: {
      h: "Longitude"
      n: "longitude"
      r: false
      sh: "Longitude coordinate"
      t: "`$NUMBER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "City name"
      t: "`$STRING`"
    }
    normalizedName: {
      h: "Normalized Name"
      n: "normalizedName"
      r: true
      sh: "Normalized city name"
      t: "`$STRING`"
    }
    officialWebsite: {
      h: "Official Website"
      n: "officialWebsite"
      r: false
      sh: "Official website URL"
      t: "`$STRING`"
    }
    population: {
      h: "Population"
      n: "population"
      r: false
      sh: "Population of the city"
      t: "`$NUMBER`"
    }
    postalCode: {
      h: "Postal Code"
      n: "postalCode"
      r: false
      sh: "Postal code"
      t: "`$STRING`"
    }
    regionCode: {
      h: "Region Code"
      n: "regionCode"
      r: true
      sh: "Region code"
      t: "`$STRING`"
    }
    regionId: {
      h: "Region Id"
      n: "regionId"
      r: true
      sh: "UUID of the region"
      t: "`$STRING`"
    }
    regionName: {
      h: "Region Name"
      n: "regionName"
      r: true
      sh: "Region name"
      t: "`$STRING`"
    }
    timeZone: {
      h: "Time Zone"
      n: "timeZone"
      r: false
      sh: "Time zone"
      t: "`$STRING`"
    }
    translations: {
      h: "Translations"
      n: "translations"
      r: true
      sh: "Translations of the city name in requested languages"
      t: "`$ARRAY`"
    }
    wikidataId: {
      h: "Wikidata Id"
      n: "wikidataId"
      r: true
      sh: "Wikidata ID of the city"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "city"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /cities/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/cities/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "cities"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
