# BasicOneshotFlow

main: kit: flow: BasicOneshotFlow:
{
  entity: "oneshot",
  kind: "basic",
  name: "BasicOneshotFlow",
  step: [
    {
      m: {
        city_name: "city_name01",
        country: "country01",
        language: "language01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "oneshot_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOneshotFlow"
}